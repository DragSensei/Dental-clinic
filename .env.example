# Database
DATABASE_URL="postgresql://user:password@localhost:5432/dental_reservation_db?schema=public"

# App URL (usually your localhost or production domain)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Better Auth Configuration
# Generate a secret using: openssl rand -base64 32
BETTER_AUTH_SECRET="your-super-secret-key-here"
BETTER_AUTH_URL="http://localhost:3000"

# Email Configuration (Resend) - Optional in development (uncomment and set a real key to enable email verification)
# RESEND_API_KEY=""
EMAIL_SENDER_NAME="Dental Clinic"
EMAIL_SENDER_ADDRESS="onboarding@resend.dev"

# Google OAuth 2.0 and Google Calendar API configuration - Optional (uncomment and set real credentials to enable Google OAuth)
# Create OAuth 2.0 Credentials in the Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Ensure the Google Calendar API is enabled in your Google Cloud project.
# Authorized Redirect URI: http://localhost:3000/api/auth/google/callback
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Demo Controls & Seeding (set DEMO_MODE="false" and NEXT_PUBLIC_DEMO_MODE="false" in production)
DEMO_MODE="false"
NEXT_PUBLIC_DEMO_MODE="false"
# SEED_DEMO_PASSWORD="" # Required when seeding in production with DEMO_MODE="true"
