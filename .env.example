# Database
DATABASE_URL="postgresql://user:password@localhost:5432/dental_reservation_db?schema=public"

# App URL (usually your localhost or production domain)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Better Auth Configuration
# Generate a secret using: openssl rand -base64 32
BETTER_AUTH_SECRET="your-super-secret-key-here"
BETTER_AUTH_URL="http://localhost:3000"

# Email Configuration (Resend) - Optional in development
RESEND_API_KEY="re_..."
EMAIL_SENDER_NAME="Dental Clinic"
EMAIL_SENDER_ADDRESS="onboarding@resend.dev"

# Google OAuth 2.0 and Google Calendar API configuration
# Create OAuth 2.0 Credentials in the Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Ensure the Google Calendar API is enabled in your Google Cloud project.
# Authorized Redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
